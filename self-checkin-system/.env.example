# AWS S3 Storage Configuration
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=selfcheckin-storage

# SMTP Email Sender Configuration
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# JWT Security Secret (Minimum 32 Characters)
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/self_checkin_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgresql_password
